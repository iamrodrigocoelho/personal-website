# ============================================================
# RODRIGO COELHO — LANDING PAGE — VARIÁVEIS DE AMBIENTE
# ============================================================
# Copie este arquivo para .env.local e preencha os valores.
# Nunca versione .env.local — ele já está no .gitignore.
# ============================================================

# --- ANALYTICS (opcional) ---
# Google Analytics 4 Measurement ID (ex: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity Project ID
NEXT_PUBLIC_CLARITY_ID=

# --- FORMULÁRIO DE CONTATO ---
# Formspree form ID (ex: abcdef01)
# Crie uma conta em https://formspree.io e substitua o valor.
# Se vazio, o formulário usa fallback mailto:
NEXT_PUBLIC_FORMSPREE_ID=

# Google reCAPTCHA v3 — Site Key (chave pública)
# Crie em https://www.google.com/recaptcha/admin → tipo "reCAPTCHA v3"
# Domínio: iamrodrigocoelho.com (e localhost para testes)
# Se vazio, reCAPTCHA não é carregado e o formulário ainda funciona normalmente.
# IMPORTANTE: configure também o Formspree para verificar o token reCAPTCHA
# em Settings → reCAPTCHA do seu formulário.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
