# ============================================================
# RODRIGO COELHO — LANDING PAGE — VARIÁVEIS DE AMBIENTE
# ============================================================
# Copie este arquivo para .env.local e preencha os valores.
# Nunca versione .env.local — ele já está no .gitignore.
# ============================================================

# --- ANALYTICS (opcional) ---
# Google Analytics 4 Measurement ID (ex: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity Project ID
NEXT_PUBLIC_CLARITY_ID=

# --- FORMULÁRIO DE CONTATO (Resend) ---
# API Key do Resend (https://resend.com → API Keys)
# Usada APENAS no servidor, pela rota /api/contact. Nunca exponha no browser.
# Se vazia, o formulário usa fallback mailto:
RESEND_API_KEY=

# E-mail que RECEBE as mensagens do formulário
CONTACT_TO_EMAIL=

# Remetente dos e-mails (precisa ser de um domínio verificado no Resend,
# ex: "Contato <contato@iamrodrigocoelho.com>").
# Se vazio, usa "Contato <onboarding@resend.dev>" — que só entrega para o
# e-mail da própria conta Resend (modo de teste).
CONTACT_FROM_EMAIL=

# --- GOOGLE reCAPTCHA v3 ---
# Crie as chaves em https://www.google.com/recaptcha/admin → tipo "reCAPTCHA v3"
# Domínio: iamrodrigocoelho.com (e localhost para testes)

# Site Key (pública — embutida no build, carrega o script no browser)
# Se vazia, reCAPTCHA não é carregado e o formulário ainda funciona normalmente.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Secret Key (privada — usada APENAS no servidor, pela rota /api/contact,
# para verificar o token junto ao Google antes de enviar a mensagem).
# Configure sempre em par com NEXT_PUBLIC_RECAPTCHA_SITE_KEY.
RECAPTCHA_SECRET_KEY=
